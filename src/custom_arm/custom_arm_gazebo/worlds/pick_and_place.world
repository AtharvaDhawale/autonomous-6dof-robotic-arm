<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pick_and_place_world">

    <!-- Physics Engine Settings (ODE optimized for stable manipulation) -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Essential Gazebo Sim Systems -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <!-- Gravity & Atmosphere -->
    <gravity>0 0 -9.81</gravity>

    <!-- Ambient Scene Lighting -->
    <scene>
      <ambient>0.4 0.4 0.45 1.0</ambient>
      <background>0.7 0.75 0.8 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun Directional Light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>10000000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.82 1.0</ambient>
            <diffuse>0.8 0.8 0.82 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Work Table (Center at X=0.0m, Y=-0.45m, Z=0.20m, size: 0.8m x 0.8m x 0.40m, top surface at Z=0.40m) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.0 -0.45 0.20 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.40</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>10000000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.40</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.28 0.32 1.0</ambient>
            <diffuse>0.30 0.35 0.40 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Graspable Orange Cube (0.035m x 0.035m x 0.035m, mass: 0.025kg, placed at X=0.0m, Y=-0.54m, Z=0.42m) -->
    <model name="target_cube">
      <pose>0.0 -0.54 0.42 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>5.104e-6</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>5.104e-6</iyy>
            <iyz>0.0</iyz>
            <izz>5.104e-6</izz>
          </inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>1.0</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.45 0.05 1.0</ambient>
            <diffuse>0.95 0.45 0.05 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Destination Bin / Basket (Position at X=0.36m, Y=-0.36m, Z=0.42m aligned with Phase 5 & 6) -->
    <model name="destination_bin">
      <static>true</static>
      <pose>0.36 -0.36 0.41 0 0 0</pose>
      <link name="bin_link">
        <!-- Base Tray Plate -->
        <collision name="bin_base_collision">
          <geometry>
            <box>
              <size>0.16 0.16 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="bin_base_visual">
          <geometry>
            <box>
              <size>0.16 0.16 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.85 1.0</ambient>
            <diffuse>0.15 0.45 0.85 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>

        <!-- Retaining Lip Walls -->
        <visual name="wall_north_vis">
          <pose>0 0.075 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.01 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.35 0.75 1.0</ambient>
            <diffuse>0.12 0.35 0.75 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_north_col">
          <pose>0 0.075 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.01 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_south_vis">
          <pose>0 -0.075 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.01 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.35 0.75 1.0</ambient>
            <diffuse>0.12 0.35 0.75 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_south_col">
          <pose>0 -0.075 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.01 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_east_vis">
          <pose>0.075 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.14 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.35 0.75 1.0</ambient>
            <diffuse>0.12 0.35 0.75 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_east_col">
          <pose>0.075 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.14 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_west_vis">
          <pose>-0.075 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.14 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.35 0.75 1.0</ambient>
            <diffuse>0.12 0.35 0.75 1.0</diffuse>
          </material>
        </visual>
        <collision name="wall_west_col">
          <pose>-0.075 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.14 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
