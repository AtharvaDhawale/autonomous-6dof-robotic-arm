<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pick_and_place_world">

    <!-- Physics Engine Settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Essential Gazebo Sim Systems -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <!-- Gravity & Atmosphere -->
    <gravity>0 0 -9.81</gravity>

    <!-- Ambient Scene Lighting -->
    <scene>
      <ambient>0.4 0.4 0.45 1.0</ambient>
      <background>0.7 0.75 0.8 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun Light Source -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>10000000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.82 1.0</ambient>
            <diffuse>0.8 0.8 0.82 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pedestal Table (box 0.6m x 0.6m x 0.4m at origin Z=0.2m) -->
    <model name="pedestal_table">
      <static>true</static>
      <pose>0 0 0.2 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>10000000.0</kp>
                <kd>1.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.28 0.32 1.0</ambient>
            <diffuse>0.3 0.35 0.4 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Graspable Object (cube 0.035m, mass 0.03kg, color orange at X=0.30m, Y=0.0m, Z=0.4175m) -->
    <model name="target_cube">
      <pose>0.30 0.0 0.4175 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>6.125e-6</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>6.125e-6</iyy>
            <iyz>0.0</iyz>
            <izz>6.125e-6</izz>
          </inertia>
        </inertial>
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000.0</kp>
                <kd>1.0</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.035 0.035 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.4 0.05 1.0</ambient>
            <diffuse>0.95 0.4 0.05 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
