<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="custom_arm">

  <!-- Visual Materials -->
  <material name="body_grey">
    <color rgba="0.75 0.78 0.85 1.0" />
  </material>
  <material name="accent_white">
    <color rgba="0.95 0.95 0.95 1.0" />
  </material>
  <material name="finger_dark">
    <color rgba="0.25 0.25 0.28 1.0" />
  </material>

  <!-- 1. World Link & Base Attachment -->
  <link name="world"/>

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- 2. Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="4.1633E-17 0 0.073876" rpy="0 0 0" />
      <mass value="17.147" />
      <inertia ixx="0.192" ixy="-4.9423E-10" ixz="1.2752E-17" iyy="0.192" iyz="2.6417E-18" izz="0.29544" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/base_link.STL" />
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 3. Joint 1 & Link 1 -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.2" rpy="1.5708 0 1.5708" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="3.142" effort="300" velocity="3" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <link name="link_1">
    <inertial>
      <origin xyz="-2.5757E-14 0.11047 -7.8988E-11" rpy="0 0 0" />
      <mass value="3.0905" />
      <inertia ixx="0.026302" ixy="-2.5267E-15" ixz="-1.4177E-12" iyy="0.019632" iyz="-7.4535E-12" izz="0.025388" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_1.STL" />
      </geometry>
      <material name="accent_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_1.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 4. Joint 2 & Link 2 -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.205 0" rpy="0 0 0" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="200" velocity="3" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <link name="link_2">
    <inertial>
      <origin xyz="-1.1102E-16 0.16752 -2.498E-16" rpy="0 0 0" />
      <mass value="5.5867" />
      <inertia ixx="0.12632" ixy="8.4877E-17" ixz="7.8685E-19" iyy="0.011401" iyz="1.4432E-16" izz="0.12911" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_2.STL" />
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_2.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 5. Joint 3 & Link 3 -->
  <joint name="joint_3" type="revolute">
    <origin xyz="0 0.4 0" rpy="0 0 0" />
    <parent link="link_2" />
    <child link="link_3" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="3.142" effort="200" velocity="3" />
    <dynamics damping="0.4" friction="0.1" />
  </joint>

  <link name="link_3">
    <inertial>
      <origin xyz="-0.17893 0 -1.249E-16" rpy="0 0 0" />
      <mass value="2.8262" />
      <inertia ixx="0.0074041" ixy="-1.7927E-17" ixz="4.2672E-17" iyy="0.028552" iyz="-3.4736E-10" izz="0.025128" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_3.STL" />
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_3.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 6. Joint 4 & Link 4 (FIXED: inverted limit bug from SolidWorks exporter) -->
  <joint name="joint_4" type="revolute">
    <origin xyz="-0.35 0 0" rpy="0 0 1.5708" />
    <parent link="link_3" />
    <child link="link_4" />
    <axis xyz="0 0 1" />
    <limit lower="-3.142" upper="0.0" effort="200" velocity="3" />
    <dynamics damping="0.3" friction="0.05" />
  </joint>

  <link name="link_4">
    <inertial>
      <origin xyz="-0.051672 -2.2204E-16 -1.1102E-16" rpy="0 0 0" />
      <mass value="1.8097" />
      <inertia ixx="0.0023112" ixy="-9.6437E-18" ixz="-9.9829E-19" iyy="0.0096102" iyz="1.3194E-19" izz="0.0093908" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_4.STL" />
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_4.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 7. Joint 5 & Link 5 -->
  <joint name="joint_5" type="revolute">
    <origin xyz="-0.188 0 0" rpy="0 0 0" />
    <parent link="link_4" />
    <child link="link_5" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="3.142" effort="200" velocity="3" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <link name="link_5">
    <inertial>
      <origin xyz="-0.018544 0 -2.7756E-17" rpy="0 0 0" />
      <mass value="0.19053" />
      <inertia ixx="0.00030197" ixy="1.6611E-20" ixz="3.6309E-21" iyy="0.00022817" iyz="-1.9664E-11" izz="0.00011843" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_5.STL" />
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_5.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 8. Joint 6 & Link 6 (Left Gripper Finger) -->
  <joint name="joint_6" type="prismatic">
    <origin xyz="0.54 -0.4 0" rpy="0 0 0" />
    <parent link="link_5" />
    <child link="link_6" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="0.03" effort="100" velocity="3" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

  <link name="link_6">
    <inertial>
      <origin xyz="-0.60237 0.4 -0.016013" rpy="0 0 0" />
      <mass value="0.11653" />
      <inertia ixx="3.9246E-05" ixy="-9.4878E-20" ixz="1.0258E-05" iyy="7.1189E-05" iyz="-3.4206E-20" izz="8.4875E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_6.STL" />
      </geometry>
      <material name="finger_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_6.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 9. Joint 7 & Link 7 (Right Gripper Finger) -->
  <joint name="joint_7" type="prismatic">
    <origin xyz="0.54 0.4 0" rpy="3.1416 0 0" />
    <parent link="link_5" />
    <child link="link_7" />
    <axis xyz="0 0 1" />
    <limit lower="-0.03" upper="0" effort="100" velocity="3" />
    <dynamics damping="0.1" friction="0.05" />
    <mimic joint="joint_6" multiplier="-1" offset="0" />
  </joint>

  <link name="link_7">
    <inertial>
      <origin xyz="-0.60237 0.4 -0.016013" rpy="0 0 0" />
      <mass value="0.11653" />
      <inertia ixx="3.9246E-05" ixy="-4.7946E-20" ixz="1.0258E-05" iyy="7.1189E-05" iyz="-3.946E-20" izz="8.4875E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/visual/link_7.STL" />
      </geometry>
      <material name="finger_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://custom_arm_description/meshes/collision/link_7.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 10. TCP (Tool Center Point) Frame centered between finger origins -->
  <joint name="tcp_joint" type="fixed">
    <parent link="link_5" />
    <child link="tcp" />
    <origin xyz="0.54 0 0" rpy="0 0 0" />
  </joint>

  <link name="tcp"/>

  <!-- ROS 2 CONTROL HARDWARE INTERFACE -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimHardware</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.03</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_7">
      <param name="mimic">joint_6</param>
      <param name="multiplier">-1</param>
      <state_interface name="position">
        <param name="initial_value">-0.03</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- GAZEBO SIMULATION PLUGINS & LINK SURFACE PROPERTIES -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find custom_arm_control)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_1">
    <material>Gazebo/White</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_2">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_3">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_4">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_5">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="link_6">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="link_7">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

</robot>
